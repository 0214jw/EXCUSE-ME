# Backend process environment only. Never use VITE_ prefixes for these variables.
# This example is not automatically loaded; see README for shell setup.
GEMINI_API_KEY=
GEMINI_CURATOR_MODEL=gemini-3.5-flash-lite
# Network timeout, clamped to 5~25 seconds. No automatic provider retries.
GEMINI_CURATOR_TIMEOUT_SECONDS=20

# Paid painting generation is OFF until the shared-key owner approves a test.
# Fixed server options: gpt-image-2 / medium / 768x1024 (3:4) / n=1 / PNG.
OPENAI_API_KEY=
OPENAI_IMAGE_ENABLED=0
# Rolling 24h attempts, lifetime attempts, lifetime reservation budget (US cents).
# Failed/timeout calls count too; ledger survives restarts. No automatic retries.
OPENAI_IMAGE_DAILY_LIMIT=3
OPENAI_IMAGE_TOTAL_LIMIT=10
OPENAI_IMAGE_BUDGET_CENTS=100
# Optional private file directory; default: uploads/paintings (Git-ignored).
# EXCUSE_ME_IMAGE_DIR=
