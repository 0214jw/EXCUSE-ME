# Backend process environment only. Never use VITE_ prefixes for these variables.
# This example is not automatically loaded; see README for masked PowerShell input.
OPENAI_API_KEY=
OPENAI_CURATOR_MODEL=gpt-5.6-terra
# Network timeout, clamped to 5~25 seconds. No automatic provider retries.
OPENAI_CURATOR_TIMEOUT_SECONDS=20
